{
  "name": "vitality",
  "private": true,
  "version": "0.0.1",
  "description": "An open standard and toolkit for measuring open source project health",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check:boundaries": "turbo run check:boundaries",
    "dev": "turbo run dev --parallel"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "turbo": "^2.5.4",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.15.0",
    "dependency-cruiser": "^16.8.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2"
  },
  "workspaces": [
    "packages/*"
  ]
}
