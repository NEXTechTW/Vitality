{
  "name": "@vitality/api",
  "version": "0.1.0",
  "description": "Vitality REST API — project health scores, history, badges.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "db:migrate": "node dist/db/migrate.js"
  },
  "dependencies": {
    "@vitality/scoring-engine": "workspace:*",
    "@vitality/collectors": "workspace:*",
    "@vitality/cli": "workspace:*",
    "fastify": "^5.2.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/swagger": "^9.3.0",
    "@fastify/swagger-ui": "^5.2.0",
    "postgres": "^3.4.5",
    "ioredis": "^5.4.2",
    "zod": "^3.23.8",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "typescript": "*",
    "vitest": "*",
    "@types/node": "*",
    "tsx": "*"
  }
}
