{
  "name": "@vitality/cli",
  "version": "0.1.0",
  "description": "Vitality CLI — analyze open source health from your terminal.",
  "type": "module",
  "bin": {
    "vitality": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "dev": "tsx src/bin.ts"
  },
  "dependencies": {
    "@vitality/scoring-engine": "workspace:*",
    "@vitality/collectors": "workspace:*",
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "ora": "^8.1.1",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "typescript": "*",
    "vitest": "*",
    "@types/node": "*",
    "tsx": "*"
  }
}
